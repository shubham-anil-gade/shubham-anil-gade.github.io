---
---
<div id="sg-analytics-banner" hidden
     role="region" aria-label="Analytics consent">
  <strong>Website analytics</strong>
  <p>
    This website uses optional Google Analytics cookies
    to understand visitor traffic, popular pages and
    engagement. Analytics data is shared with Google.
    No advertising tracking is enabled.
    <a href="https://policies.google.com/technologies/partner-sites"
       target="_blank" rel="noopener noreferrer">
      Learn more
    </a>
  </p>
  <button id="sg-analytics-accept" type="button">
    Accept analytics
  </button>
  <button id="sg-analytics-reject" type="button">
    Decline
  </button>
</div>

<div class="sg-analytics-preferences">
  <button id="sg-analytics-settings" type="button">
    Analytics preferences
  </button>
</div>

<style>
  #sg-analytics-banner {
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 380px;
    max-width: calc(100vw - 40px);
    box-sizing: border-box;
    background: #ffffff;
    color: #17352e;
    padding: 22px;
    border: 1px solid #d7e3de;
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.12);
    z-index: 9999;
    font-size: 14px;
  }

  #sg-analytics-banner p {
    margin: 10px 0 16px;
    line-height: 1.6;
  }

  #sg-analytics-banner button {
    font: inherit;
    padding: 9px 14px;
    border: 1px solid #0f4b3f;
    border-radius: 7px;
    cursor: pointer;
    margin: 3px;
  }

  #sg-analytics-accept {
    background: #0f4b3f;
    color: white;
  }

  #sg-analytics-reject {
    background: white;
    color: #0f4b3f;
  }

  .sg-analytics-preferences {
    text-align: center;
    padding: 10px;
  }

  #sg-analytics-settings {
    font: inherit;
    font-size: 12px;
    color: #0f4b3f;
    background: transparent;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
</style>

<script is:inline>
(function () {
  const id = 'G-K07BW7VHMK';
  const key = 'sg-analytics-consent';
  const banner = document.getElementById('sg-analytics-banner');

  let started = false;
  let preference = null;

  try {
    preference = localStorage.getItem(key);
  } catch (_) {}

  window.dataLayer = window.dataLayer || [];

  function gtag() {
    window.dataLayer.push(arguments);
  }

  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied'
  });

  function startAnalytics() {
    if (started) return;
    started = true;

    window['ga-disable-' + id] = false;

    gtag('consent', 'update', {
      analytics_storage: 'granted'
    });

    gtag('js', new Date());

    gtag('config', id, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
      cookie_domain: 'none'
    });

    const script = document.createElement('script');
    script.async = true;
    script.src =
      'https://www.googletagmanager.com/gtag/js?id=' + id;
    document.head.appendChild(script);
  }

  function savePreference(value) {
    try {
      localStorage.setItem(key, value);
    } catch (_) {}
  }

  document.getElementById('sg-analytics-accept')
    .addEventListener('click', function () {
      savePreference('accepted');
      banner.hidden = true;
      startAnalytics();
    });

  document.getElementById('sg-analytics-reject')
    .addEventListener('click', function () {
      savePreference('declined');
      window['ga-disable-' + id] = true;

      document.cookie.split(';').forEach(function (cookie) {
        const name = cookie.split('=')[0].trim();
        if (name === '_ga' || name.startsWith('_ga_')) {
          document.cookie = name +
            '=; Max-Age=0; Path=/; Secure; SameSite=Lax';
        }
      });

      banner.hidden = true;

      if (started) window.location.reload();
    });

  document.getElementById('sg-analytics-settings')
    .addEventListener('click', function () {
      banner.hidden = false;
    });

  if (preference === 'accepted') {
    startAnalytics();
  } else if (preference !== 'declined') {
    banner.hidden = false;
  }
})();
</script>
