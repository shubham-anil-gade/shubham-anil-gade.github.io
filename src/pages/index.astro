---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <div class="kicker">Agricultural Engineer · Precision Agriculture Researcher</div>
        <h1 class="hero-name">Shubham <em>Gade</em></h1>
        <h2 class="hero-motto">Engineering smarter agriculture through <em>sensing</em> and resource management.</h2>
        <p class="lead">I am a PhD Researcher at the Asian Institute of Technology (AIT), Thailand, working across precision irrigation, remote sensing, crop phenotyping, geospatial analytics and data-driven agriculture.</p>
        <div class="hero-meta"><span>PhD Researcher</span><span>•</span><span>Asian Institute of Technology, Thailand</span></div>
        <div class="hero-actions"><a class="btn primary" href="/research/">Explore my research →</a><a class="btn" href="/publications/">View publications</a></div>
        <div class="social-row">
          <a href="https://scholar.google.com/citations?user=HjwHs4sAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a>
          <a href="https://orcid.org/0000-0003-1671-8394" target="_blank" rel="noopener noreferrer">ORCID</a>
          <a href="https://www.scopus.com/authid/detail.uri?authorId=57226315750" target="_blank" rel="noopener noreferrer">Scopus</a>
          <a href="https://www.researchgate.net/profile/Shubham-Gade-2/research" target="_blank" rel="noopener noreferrer">ResearchGate</a>
          <a href="https://www.linkedin.com/in/shubham-gade-66807215a" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="https://github.com/shubham-anil-gade" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
      <div class="hero-media"><div class="hero-image"><img src="/images/homepage-portrait.webp" alt="Shubham Gade holding harvested bell peppers in a greenhouse research experiment" /></div><div class="data-chip"><strong>Precision crop sensing</strong><span>RGB · Thermal · Multispectral · UAV</span><div class="data-dots"><i></i><i></i><i></i></div></div></div>
    </div>
  </section>

  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Research Focus</div><h2>Agriculture, sensing and data—connected.</h2></div><p class="lead">My work links agricultural engineering with sensing and analytics to improve how water, nutrients and crop resources are monitored and managed.</p></div><div class="research-grid">
    <article class="research-card"><div class="card-num">01</div><h3>Precision Irrigation & Water Management</h3><p>Crop water productivity, deficit irrigation, crop-water-stress assessment and resource-efficient water management.</p><a class="card-link" href="/research/#water">Explore →</a></article>
    <article class="research-card"><div class="card-num">02</div><h3>Remote Sensing & Crop Phenotyping</h3><p>RGB, thermal, multispectral and UAV-based sensing for crop growth, stress, physiology and nutrient monitoring.</p><a class="card-link" href="/research/#sensing">Explore →</a></article>
    <article class="research-card"><div class="card-num">03</div><h3>AI, Geospatial Analytics & Digital Agriculture</h3><p>Machine learning, computer vision, GIS and cloud geospatial platforms for agricultural monitoring and decision support.</p><a class="card-link" href="/research/#digital">Explore →</a></article>
    <article class="research-card"><div class="card-num">04</div><h3>Climate-Smart & Resource-Efficient Agriculture</h3><p>Climate information, agricultural advisory systems and integrated approaches for resilient production systems.</p><a class="card-link" href="/research/#climate">Explore →</a></article>
  </div></div></section>

  <section class="section compact"><div class="container feature"><div class="feature-media"><img src="/images/greenhouse-symmetry.webp" alt="Controlled-environment greenhouse research setup" /></div><div class="feature-copy"><div class="eyebrow">Doctoral Spotlight</div><h2>Precision management of water and nutrients in controlled environments.</h2><p>My doctoral research integrates irrigation, biochar, nitrogen management and advanced crop imaging to improve crop productivity, resource-use efficiency and plant-stress monitoring.</p><div class="tags"><span class="tag">Precision Irrigation</span><span class="tag">Biochar</span><span class="tag">Crop Phenotyping</span><span class="tag">RGB / Thermal / Multispectral</span></div><a class="btn" href="/research/#doctoral">Explore doctoral research →</a></div></div></section>

  <section class="section" id="publications"><div class="container"><div class="section-head"><div><div class="eyebrow">Selected Publications</div><h2>Research outputs</h2></div><a class="btn" href="/publications/">View all publications →</a></div><div class="publication-feature"><div><div class="pub-year">FEATURED · 2025</div></div><div><a class="pub-feature-title publication-title-link" href="https://doi.org/10.1016/j.rsase.2024.101418" target="_blank" rel="noopener noreferrer">Advancements in UAV remote sensing for agricultural yield estimation</a><div class="pub-meta"><strong>Shubham A. Gade</strong> et al. · <em>Remote Sensing Applications: Society and Environment</em></div><div class="tags" style="margin-top:18px"><span class="tag light-tag">UAV</span><span class="tag light-tag">Remote Sensing</span><span class="tag light-tag">Yield Estimation</span></div></div></div><div class="pub-list">
    <a class="pub-row publication-row-link" href="https://doi.org/10.1007/s00704-026-06315-7" target="_blank" rel="noopener noreferrer"><div class="pub-year">2026</div><div><h3>Non-stationarity and temporal dependence of seasonal and extreme rainfall in Thailand and their linkages with ENSO and IOD</h3><p>Theoretical and Applied Climatology</p></div><div class="pub-arrow">↗</div></a>
    <a class="pub-row publication-row-link" href="https://doi.org/10.1007/s10661-023-11429-w" target="_blank" rel="noopener noreferrer"><div class="pub-year">2023</div><div><h3>Implication of climate change on crop water requirement in the semi-arid region of Western Maharashtra, India</h3><p>Environmental Monitoring and Assessment</p></div><div class="pub-arrow">↗</div></a>
  </div></div></section>

  <section class="section" id="projects"><div class="container"><div class="section-head"><div><div class="eyebrow">Selected Projects</div><h2>Research in application.</h2></div><a class="btn" href="/projects/">Explore projects →</a></div><div class="project-grid project-grid-text">
    <a class="project-card-text featured" href="/projects/#phd"><div class="project-index">01 · DOCTORAL RESEARCH</div><h3>Smart Greenhouse & Precision Crop Management</h3><p>Integrating water, nutrients, sensing and data-driven approaches for bell pepper production.</p><span>AIT · Thailand · 2023–Present →</span></a>
    <a class="project-card-text" href="/projects/#afas"><div class="project-index">02 · COLLABORATIVE PROJECT</div><h3>AFAS</h3><p>Climate information and digital agricultural advisories for farmer decision support in Thailand and Vietnam.</p><span>Thailand & Vietnam · 2024–2027 →</span></a>
    <a class="project-card-text" href="/projects/#asis"><div class="project-index">03 · PROFESSIONAL RESEARCH</div><h3>ASIS</h3><p>Geospatial intelligence, Earth observation and digital resources for agricultural abiotic-stress assessment.</p><span>ICAR-NIASM · India · 2021–2023 →</span></a>
  </div></div></section>

  <section class="section compact" id="posts"><div class="container writing-feature"><div><div class="eyebrow">Writing & Research Notes</div><h2>Sharing methods, field experience and research perspectives.</h2></div><div class="writing-feature-copy"><p>Posts will cover research notes, technical workflows, field observations and perspectives from precision agriculture and agricultural engineering.</p><div class="category-line"><span>Research Notes</span><span>Technical</span><span>Field Notes</span><span>Perspectives</span></div><a class="btn" href="/posts/">Visit Posts →</a></div></div></section>

  <section class="section compact"><div class="container"><div class="section-head"><div><div class="eyebrow">Research & Fieldwork</div><h2>Work in practice.</h2></div></div><div class="gallery-strip">
    <div class="gallery-item"><img src="/images/hero-drone.webp" alt="Shubham Gade operating a UAV for greenhouse crop imaging"/><div class="gallery-caption">UAV-based crop imaging · Controlled-environment research</div></div>
    <div class="gallery-item"><img src="/images/smart-greenhouse-presentation.webp" alt="Shubham Gade presenting smart greenhouse research"/><div class="gallery-caption">Research communication · Smart greenhouse systems</div></div>
    <div class="gallery-item"><img src="/images/greenhouse-fieldwork.webp" alt="Greenhouse crop research activity"/><div class="gallery-caption">Controlled-environment crop research</div></div>
  </div></div></section>

  <section class="section" id="awards"><div class="container"><div class="section-head"><div><div class="eyebrow">Recognition</div><h2>Awards & recognition</h2></div><a class="btn" href="/awards/">View all recognition →</a></div><div class="awards awards-hover"><a class="award-row award-link" href="https://ait.ac.th/2026/03/ait-phd-student-wins-first-prize-at-4th-roorkee-water-conclave-2026-at-the-indian-institute-of-technology-roorkee-india/" target="_blank" rel="noopener noreferrer"><div class="year">2026</div><strong>1st Prize · Oral Presentation ↗</strong><div class="where">4th Roorkee Water Conclave · Indian Institute of Technology Roorkee</div></a>
<a class="award-row award-link" href="https://ait.ac.th/2025/08/ait-students-explore-water-disaster-prevention-and-cultural-exchange-at-hohai-university-china/" target="_blank" rel="noopener noreferrer"><div class="year">2025</div><strong>Best Presentation Award ↗</strong><div class="where">Hohai University International Summer Program · Nanjing, China</div></a>
<a class="award-row award-link" href="https://ait.ac.th/sustainability-initiatives/" target="_blank" rel="noopener noreferrer"><div class="year">2025</div><strong>2nd Prize · AIT Decarbonization Nexus ↗</strong><div class="where">Inter-University SDG Research Fair · Asian Institute of Technology</div></a>
<a class="award-row award-link" href="https://ait.ac.th/2024/12/workshop-equips-farming-communities-with-regenerative-agriculture-tools-for-sustainable-rice-production/" target="_blank" rel="noopener noreferrer"><div class="year">2024</div><strong>3rd Prize · Poster Competition ↗</strong><div class="where">International Workshop on Regenerative Agriculture · AIT</div></a>
<a class="award-row award-link" href="https://ait.ac.th/2024/11/sustainability-in-action-research-trends-workshop-and-sdg-competition-propel-innovation-and-collaboration-at-ait/" target="_blank" rel="noopener noreferrer"><div class="year">2024</div><strong>2nd Prize · SDGs Research Competition ↗</strong><div class="where">Sustainability Research Trends Workshop · Asian Institute of Technology</div></a>
<div class="award-row"><div class="year">2023</div><strong>2nd Prize · Sustainability Expo / AIT SDG Research Fair</strong><div class="where">Asian Institute of Technology</div></div>
<div class="award-row"><div class="year">2023</div><strong>Best Young Professional Staff Award</strong><div class="where">ICAR–National Institute of Abiotic Stress Management</div></div></div></div></section>
</BaseLayout>
