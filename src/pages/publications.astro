<BaseLayout title="Publications | Shubham Gade" description="Publications by Shubham Gade in precision agriculture, remote sensing, water management, climate and geospatial research.">
  <section class="page-hero"><div class="container"><div class="eyebrow">Publications</div><h1>Publications.</h1><p class="lead">Verified published research spanning precision agriculture, remote sensing, agricultural water management, climate variability and geospatial applications.</p><div class="social-row"><a href="https://scholar.google.com/citations?user=HjwHs4sAAAAJ&hl=en" target="_blank" rel="noopener noreferrer">Google Scholar</a><a href="https://orcid.org/0000-0003-1671-8394" target="_blank" rel="noopener noreferrer">ORCID</a><a href="https://www.scopus.com/authid/detail.uri?authorId=57226315750" target="_blank" rel="noopener noreferrer">Scopus</a><a href="https://www.researchgate.net/profile/Shubham-Gade-2/research" target="_blank" rel="noopener noreferrer">ResearchGate</a></div></div></section>
  <section class="section compact"><div class="container"><div class="publication-note"><strong>Verified record</strong><p>Published items below were checked against DOI/publisher records during the August 2026 pre-launch audit. Citation counts are intentionally omitted because they change over time.</p></div>
    {years.map(year => <section class="pub-year-section"><h2>{year}</h2>{pubs.filter(p=>p.year===year).map(p => <article class="publication-entry"><div class="eyebrow">{p.type}</div><h3><a class="publication-title-link" href={p.url} target="_blank" rel="noopener noreferrer">{p.title} ↗</a></h3><p>{authorParts(p.authors).map(part => part === 'Gade SA' ? <strong>Gade SA</strong> : part)}</p><p><em>{p.venue}</em> · <a href={p.url} target="_blank" rel="noopener noreferrer" class="doi-link">{p.linkLabel} ↗</a></p></article>)}</section>)}
  </div></section>
  <section class="section compact"><div class="container"><div class="eyebrow">Preprint</div><h2>Public preprint</h2>{preprints.map(p => <article class="publication-entry"><div class="eyebrow">{p.year} · {p.type}</div><h3><a class="publication-title-link" href={p.url} target="_blank" rel="noopener noreferrer">{p.title} ↗</a></h3><p>{authorParts(p.authors).map(part => part === 'Gade SA' ? <strong>Gade SA</strong> : part)}</p><p><em>{p.venue}</em> · <a href={p.url} target="_blank" rel="noopener noreferrer" class="doi-link">DOI ↗</a></p></article>)}</div></section>
  <section class="section compact"><div class="container"><div class="eyebrow">Conference Contributions</div><h2>Selected presentations & abstracts</h2><div class="conference-list">{conferences.map(c => <div class="conference-row"><div class="year">{c[0]}</div><div><strong>{c[1]}</strong><p>{c[2]}</p></div></div>)}</div></div></section>
</BaseLayout>
